{
  "version": 2,
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [".express/**", "prisma/**", ".env.local"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)", "dest": "/api/index.js"
    }
  ]
}
