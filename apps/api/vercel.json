{
  "version": 2,
  "buildCommand": "if [ -d apps/api ]; then pnpm --dir apps/api build; else pnpm build; fi",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          ".express/**",
          "apps/api/.express/**"
        ]
      }
    }
  ],

  "routes": [
    {
      "src": "/(.*)", "dest": "/api/index.js"
    }
  ]
}
